#!/usr/bin/env lua

local lib = require("lib")
local source_branch = arg[1] or "origin/main"

local is_bare = os.execute("test -d .bare")
if not is_bare then
    io.stderr:write("Error: .bare directory not found\n")
    os.exit(1)
end

lib.exec("git fetch --all")

local worktrees = {
    { path = "main", description = "main worktree (detached, readonly)" },
    { path = "work", description = "work worktree" },
    { path = "review", description = "review worktree" },
}

for _, worktree in ipairs(worktrees) do
    local exists = os.execute("test -d " .. lib.shell_quote(worktree.path))
    if not exists then
        print("Creating " .. worktree.description .. "...")
        lib.exec("git worktree add --detach " .. lib.shell_quote(worktree.path) .. " "
            .. lib.shell_quote(source_branch))
    end
end

local mise_file = io.open("mise.local.toml", "a")
if not mise_file then
    error("Could not create mise.local.toml")
end
mise_file:close()
