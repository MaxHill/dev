#!/usr/bin/env lua

local home = os.getenv("HOME")
if not home or home == "" then
    io.stderr:write("theme: HOME is not set\n")
    os.exit(1)
end

local lib = require("lib")
local quote = lib.shell_quote

local function fail(message)
    io.stderr:write("theme: " .. message .. "\n")
    os.exit(1)
end

if arg[1] == "--help" or arg[1] == "-h" then
    print("Usage: theme [name]\nWithout a name, select a theme with rofi.")
    os.exit(0)
end

if #arg > 1 then
    fail("Usage: theme [name]")
end

local themes_dir = home .. "/dev/themes"
local output = lib.run("find " .. quote(themes_dir) .. " -mindepth 1 -maxdepth 1 -type d -printf '%f\\n'")
local themes = {}
local available = {}
for name in output:gmatch("[^\n]+") do
    themes[#themes + 1] = name
    available[name] = true
end
table.sort(themes)
if #themes == 0 then
    fail("No themes found in " .. themes_dir)
end

local theme = arg[1]
if not theme then
    if not lib.program_exists("rofi") then
        fail("rofi is not installed")
    end
    local command = "printf '%s' " .. quote(table.concat(themes, "\n") .. "\n")
        .. " | rofi -dmenu -i -no-custom -p Theme"
    local picker, err = io.popen(command, "r")
    if not picker then
        fail("Could not start rofi: " .. tostring(err))
    end
    theme = picker:read("*a"):gsub("\n$", "")
    local ok, _, code = picker:close()
    if not ok then
        if code == 1 or code == 130 then
            os.exit(0)
        end
        fail("rofi failed with exit code " .. tostring(code))
    end
    if theme == "" then
        os.exit(0)
    end
end
if not available[theme] then
    fail("Unknown theme: " .. theme)
end

local source = themes_dir .. "/" .. theme
local config_home = os.getenv("XDG_CONFIG_HOME")
if not config_home or config_home == "" then
    config_home = home .. "/.config"
end
local destination = config_home .. "/theme"

-- Validate before replacing the active theme.
for _, name in ipairs({ "appearance", "colors.css", "colors.lua", "colors.rasi", "gtk-theme", "hyprland-theme.conf", "kitty.conf" }) do
    if not lib.file_exists(source .. "/" .. name) then
        fail("Missing theme file: " .. source .. "/" .. name)
    end
end
local appearance_file = assert(io.open(source .. "/appearance", "r"))
local appearance = appearance_file:read("*a"):match("^%s*(.-)%s*$")
appearance_file:close()
if appearance ~= "light" and appearance ~= "dark" then
    fail("Invalid appearance in " .. source .. "/appearance: expected light or dark")
end
-- Desktop themes select GTK themes installed by Stow; they do not carry GTK CSS.
local gtk_theme_file = assert(io.open(source .. "/gtk-theme", "r"))
local gtk_theme = gtk_theme_file:read("*a"):match("^%s*(.-)%s*$")
gtk_theme_file:close()
if not gtk_theme:match("^[%w_-]+$") then
    fail("Invalid GTK theme name in " .. source .. "/gtk-theme")
end
local data_home = os.getenv("XDG_DATA_HOME")
if not data_home or data_home == "" then
    data_home = home .. "/.local/share"
end
local gtk_source = data_home .. "/themes/" .. gtk_theme
for _, name in ipairs({ "gtk-3.0/gtk.css", "gtk-4.0/gtk.css", "palette.css" }) do
    if not lib.file_exists(gtk_source .. "/" .. name) then
        fail("Missing installed GTK theme file: " .. gtk_source .. "/" .. name .. "; stow configs/gtk first")
    end
end

-- GTK @define-color is not web CSS. Export the same configured colors for
-- Firefox and Thunderbird, retaining both media queries for runtime switching.
local mozilla_colors = { "/* Generated from desktop colors.css files by scripts/theme. */" }
local mozilla_tokens = {
    { "bg", "surface_background_opaque" },
    { "fg", "surface_foreground" },
    { "field", "surface_field" },
    { "hover", "surface_hover" },
    { "border", "surface_border" },
}
for _, mode in ipairs({ "light", "dark" }) do
    -- A custom desktop theme replaces its appearance's palette; the opposite
    -- appearance uses the corresponding built-in desktop theme.
    local palette_path = (mode == appearance and source or themes_dir .. "/" .. mode) .. "/colors.css"
    local palette_file = io.open(palette_path, "r")
    if not palette_file then
        fail("Missing Mozilla palette: " .. palette_path)
    end
    local colors = {}
    for key, value in palette_file:read("*a"):gmatch("@define%-color%s+([%w_-]+)%s+([^;]+);") do
        colors[key] = value:match("^%s*(.-)%s*$")
    end
    palette_file:close()
    mozilla_colors[#mozilla_colors + 1] = "@media (prefers-color-scheme: " .. mode .. ") { :root {"
    for _, token in ipairs(mozilla_tokens) do
        local value = colors[token[2]]
        if not value or not value:match("^#%x%x%x%x%x%x$") then
            fail("Expected a six-digit hex color for " .. token[2] .. " in " .. palette_path)
        end
        mozilla_colors[#mozilla_colors + 1] = "  --dotfiles-" .. token[1] .. ": " .. value .. ";"
    end
    mozilla_colors[#mozilla_colors + 1] = "} }"
end

for _, program in ipairs({ "rsync", "hyprpaper", "gsettings" }) do
    if not lib.program_exists(program) then
        fail(program .. " is not installed")
    end
end

lib.exec("mkdir -p -- " .. quote(destination))
-- Theme files can have identical sizes and timestamps but different colors.
lib.exec("rsync -a --checksum --delete -- " .. quote(source .. "/") .. " " .. quote(destination .. "/"))

local mozilla_file = assert(io.open(destination .. "/mozilla-colors.css", "w"))
assert(mozilla_file:write(table.concat(mozilla_colors, "\n") .. "\n"))
assert(mozilla_file:close())

-- Libadwaita needs user CSS as well as color-scheme. Select the installed palette
-- without copying it or modifying Stow-managed files.
lib.exec("ln -sfn -- " .. quote(gtk_source .. "/palette.css") .. " " .. quote(destination .. "/gtk.css"))

-- Keep application reloads separate from theme installation.
-- Libadwaita uses color-scheme; older GTK apps use gtk-theme.
local color_scheme = appearance == "dark" and "prefer-dark" or "prefer-light"
lib.exec("gsettings set org.gnome.desktop.interface color-scheme " .. quote(color_scheme))
lib.exec("gsettings set org.gnome.desktop.interface gtk-theme " .. quote(gtk_theme))
if os.getenv("HYPRLAND_INSTANCE_SIGNATURE") and lib.program_exists("hyprctl") then
    lib.exec("hyprctl reload")
end
lib.exec("pkill -u \"$(id -u)\" -USR2 -x waybar >/dev/null 2>&1 || true")
-- Skip waiting when SwayNC is not running; re-read imported theme colors.
if lib.program_exists("swaync-client") then
    lib.exec("swaync-client -sw -rs")
end
-- SIGUSR1 reloads Kitty configuration without remote-control access.
lib.exec("pkill -u \"$(id -u)\" -USR1 -x kitty >/dev/null 2>&1 || true")
lib.exec("pkill -x hyprpaper >/dev/null 2>&1 || true")
lib.exec("hyprpaper >/dev/null 2>&1 </dev/null &")


