#!/usr/bin/env lua

local lib = require("lib")

local function usage()
    print([[Usage: git-bare-clone [-h] [-v] [-l LOCATION] repository

Clone a bare Git repository and set up an environment for working from worktrees.

Options:
  -h, --help       Show this help and exit
  -v, --verbose    Accepted for compatibility; commands are always printed
  -l, --location   Bare repository location (default: .bare)
      --no-color   Accepted for compatibility; output is not colorized]])
end

local location = ".bare"
local args = {}
local i = 1
while i <= #arg do
    local value = arg[i]
    if value == "-h" or value == "--help" then
        usage()
        os.exit(0)
    elseif value == "-v" or value == "--verbose" then
        -- Commands are verbose by default.
    elseif value == "--no-color" then
        -- Output is plain text, so no color setup is needed.
    elseif value == "-l" or value == "--location" then
        i = i + 1
        location = arg[i]
        if not location or location == "" then
            io.stderr:write("Error: --location requires a value.\n")
            os.exit(1)
        end
    elseif value:match("^%-") then
        io.stderr:write("Error: Unknown option: " .. value .. "\n")
        os.exit(1)
    else
        args[#args + 1] = value
    end
    i = i + 1
end

if #args == 0 then
    io.stderr:write("Error: Repository argument required.\n")
    usage()
    os.exit(1)
end

io.stderr:write("Cloning bare repository to " .. location .. "...\n")
local clone_args = { "git", "clone", "--bare" }
for _, value in ipairs(args) do
    clone_args[#clone_args + 1] = lib.shell_quote(value)
end
clone_args[#clone_args + 1] = lib.shell_quote(location)
lib.exec(table.concat(clone_args, " "))

io.stderr:write("Adjusting origin fetch locations...\n")
lib.exec("git -C " .. lib.shell_quote(location) .. " config remote.origin.fetch "
    .. lib.shell_quote("+refs/heads/*:refs/remotes/origin/*"))

io.stderr:write("Setting .git file contents...\n")
local gitfile, err = io.open(".git", "w")
if not gitfile then
    error("Could not write .git file: " .. tostring(err))
end
gitfile:write("gitdir: ./", location, "\n")
gitfile:close()
io.stderr:write("Success.\n")
